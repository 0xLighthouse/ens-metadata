{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:interface": "turbo run build --filter=interface",
    "build:identity": "turbo run build --filter=identity",
    "interface": "turbo run dev --filter=interface",
    "identity": "turbo run dev --filter=identity",
    "attester": "pnpm --dir workers/attester dev",
    "attester:deploy": "pnpm --dir workers/attester deploy",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.3",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@turbo/gen": "^2.9.14",
    "husky": "^9.1.7",
    "turbo": "^2.9.14"
  },
  "name": "signals",
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "overrides": {
      "csstype": "3.1.3",
      "@types/react": "18.3.23",
      "@types/react-dom": "18.3.7",
      "@inkjs/ui>react": "19.2.4",
      "basic-ftp": ">=5.2.0",
      "handlebars": ">=4.7.9",
      "@modelcontextprotocol/sdk": ">=1.26.0",
      "preact": ">=10.26.10",
      "tar": ">=7.5.7",
      "postcss": ">=8.5.10"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "vocs>react": "18",
        "vocs>react-dom": "18"
      }
    }
  }
}
