{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:interface": "turbo run build --filter=interface",
    "build:identity": "turbo run build --filter=identity",
    "interface": "turbo run dev --filter=interface",
    "identity": "turbo run dev --filter=identity",
    "playground": "turbo run dev --filter=atst-playground",
    "ethsecurity": "turbo run dev --filter=ethsecurity",
    "attester": "pnpm --dir workers/attester dev",
    "attester:deploy": "pnpm --dir workers/attester deploy",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.3",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@turbo/gen": "^2.1.3",
    "husky": "^9.1.6",
    "turbo": "^2.5.5"
  },
  "name": "signals",
  "packageManager": "pnpm@11.5.0"
}
